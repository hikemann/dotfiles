{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": "~/.config/fastfetch/logo",
    "display": {
        "separator": " ›  "
    },
    "modules": [
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "format": "cachyos",
        },
        {
            "type": "kernel",
            "key": "KER ",
            "format": "linux 7.2",
        },
        {
            "type": "packages",
            "key": "PKG ", 
            "format": {},
        },
        {
            "type": "shell",
            "key": "SH  ",
            "format": "fish",
        },
        {
            "type": "terminal",
            "key": "TER ",
            "format": "foot",
        },
        {
            "type": "wm",
            "key": "WM  ",
            "format": "hyprland",
        },
        "break",
    ]
}
