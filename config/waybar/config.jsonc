{
  "layer": "top",
  "position": "top",
  "spacing": 3,
  "height": 1,
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "hyprland/workspaces",
    "custom/cpucat"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/vpn",
    "custom/separator",
    "wireplumber"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "custom/cpucat": {
    "exec": "/home/tri/.config/waybar/scripts/catloop.sh",
    "on-click": "fuzzel"
  },
  "wireplumber": {
    "scroll-step": 1,
    "format": " {icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },
  "clock": {
    "format": "{:%m-%d-%Y %H:%M} "
  },
  "custom/vpn": {
    "format": "{}",
    "exec": "/home/tri/.config/waybar/scripts/vpn-status.sh",
    "return-type": "json",
    "interval": 2
  },
  "custom/separator": {
    "format": "|", // Символ (можно использовать "|", "•", "│", "󰇙" и т.д.)
    "interval": "once",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  }
}