{
  "layer": "top",
  "position": "top",
  "spacing": 3,
  "height": 1,
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "hyprland/workspaces",
    "custom/cpucat"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "custom/separator",
    "tray",
    "custom/vpn",
    "custom/separator",
    "wireplumber"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "custom/cpucat": {
    "exec": "~/.config/waybar/scripts/catloop.sh",
    "on-click": "fuzzel"
  },
  "wireplumber": {
    "scroll-step": 1,
    "format": " {icon} {volume}%",
    "format-muted": "",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ],
    }
  },
  "clock": {
    "format": "{:%m-%d-%Y %H:%M} "
  },
  "custom/vpn": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/vpn-status.sh",
    "return-type": "json",
    "interval": 2
  },
  "custom/separator": {
    "format": "|", // Символ (можно использовать "|", "•", "│", "󰇙" и т.д.)
    "interval": "once",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "mpris": {
    "format": "{player_icon} {artist} — {title}",
    "format-paused": "{status_icon} <i>{artist} — {title}</i>",
    "player-icons": {
      "default": "",
      "chromium": ""
    },
    "status-icons": {
      "paused": ""
    },
    "max-length": 40,
    "player": "chromium",
    "ignored-players": [
      "firefox"
    ],
    "on-click": "playerctl -p chromium play-pause",
    "on-click-right": "playerctl -p chromium next",
    "on-click-middle": "playerctl -p chromium previous"
  }
}
