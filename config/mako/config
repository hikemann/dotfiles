max-history=5
sort=-time
layer=overlay
anchor=top-right
width=350
height=150
margin=10
padding=12
border-size=2
border-radius=0
icons=1
max-icon-size=48
icon-location=left
icon-path=/home/tri/.local/share/icons/YAMIS
font=monospace 10
markup=1
format=<b>%s</b>\n%b
background-color=#181616
text-color=#c5c9c5
border-color=#c5c9c5

[urgency=low]
background-color=#181616
text-color=#a8a8a2
border-color=#c5c9c5
default-timeout=4000

[urgency=normal]
background-color=#181616
text-color=#c5c9c5
border-color=#c5c9c5
default-timeout=8000

[urgency=high]
background-color=#222020
text-color=#e6e2cc
border-color=#c4746e
default-timeout=0
